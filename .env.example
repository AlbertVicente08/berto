# Copia este archivo como ".env" y rellena SOLO los proveedores que uses.
# Berto funciona con cualquier modelo: elige uno en ajustes.

# Servidor del cerebro Python (FastAPI)
BERTO_HOST=127.0.0.1
BERTO_PORT=8765

# Modelo por defecto (formato LiteLLM: proveedor/modelo)
BERTO_MODEL=ollama/llama3.1

# Claves de API (opcionales, según el proveedor)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modelos locales con Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Atajo de teclado para invocar a Berto
BERTO_HOTKEY=Ctrl+Space
